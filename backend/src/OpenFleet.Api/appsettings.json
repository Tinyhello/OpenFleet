{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OpenFleet": "Host=localhost;Port=5432;Database=openfleet;Username=openfleet;Password=openfleet"
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "openfleet-backend",
    "ProducerId": "backend",
    "FactoryId": "demo",
    "ReconnectDelay": "00:00:02"
  },
  "Fleet": {
    "OfflineAfter": "00:00:03",
    "LivenessCheckInterval": "00:00:01",
    "CommandTimeToLive": "00:00:10",
    "VehicleTypes": {
      "agv-01": "Large",
      "agv-02": "Large",
      "agv-03": "Small"
    },
    "DispatchVehicleIds": [ "agv-01", "agv-02" ],
    "DispatchInterval": "00:00:01",
    "OutboxPollInterval": "00:00:00.500",
    "MaxDispatchAttempts": 3,
    "Parking": {
      "agv-01": { "X": -10.3, "Z": 0.2 },
      "agv-02": { "X": -8, "Z": 0.2 },
      "agv-03": { "X": -5.7, "Z": 0.2 }
    }
  },
  "Traffic": {
    "ControlInterval": "00:00:00.200",
    "Lookahead": 2,
    "ReplanAfter": "00:00:04",
    "ReplanCooldown": "00:00:03",
    "ResendAfter": "00:00:01"
  },
  "Production": {
    "TickInterval": "00:00:00.500"
  }
}
